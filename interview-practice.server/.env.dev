# Database
POSTGRES_USER=interview_practice
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=interview-practice
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host/container ports for the Docker Compose services
SERVER_PORT=8001
CLIENT_PORT=8002
# Frontend host; CORS allows http://CLIENT_HOST:CLIENT_PORT
CLIENT_HOST=localhost

# Largest document upload (the whole request, so slightly more than the file), in MB.
# Enforced by Flask and by the client container's nginx, which must agree.
MAX_UPLOAD_MB=10

# Defaults to real OpenRouter; override only to use another OpenRouter-compatible endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=60
# Persona portrait image generation (slow and billed). Set to false to skip it: interviews
# are then created without a portrait.
PORTRAIT_GENERATION_ENABLED=true
